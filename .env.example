# Copy to .env.local and fill in.
#
# Until the Medusa backend is running and a publishable key exists, leave
# NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY empty — the storefront then serves the
# mock catalog (lib/mock-catalog.ts) and still builds and runs.

# --- Local single-tenant dev fallback ---------------------------------------
# Set LOCAL_TENANT_ENABLED=true to skip host-based tenant resolution entirely
# (no DNS, no control plane needed) and always serve one tenant built from the
# two vars below. Hard-disabled whenever NODE_ENV=production, regardless of
# this flag — see lib/tenant/local-fallback.ts.
LOCAL_TENANT_ENABLED=true

# Medusa backend base URL for the local fallback tenant.
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000

# Publishable API key from Medusa Admin -> Settings -> Publishable API Keys.
# Required for store routes (sent as x-publishable-api-key by the SDK).
# As soon as this is set, the storefront talks to the real backend.
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=

# --- Multi-tenant (production) ----------------------------------------------
# Ignored while LOCAL_TENANT_ENABLED=true. See proxy.ts and
# lib/tenant/config-cache.ts for how these are used.

# The platform's base domain. A request to "<slug>.<BASE_DOMAIN>" is resolved
# as a subdomain tenant; anything else is looked up as a custom domain.
BASE_DOMAIN=jibbit.app

# Internal control-plane API this deployment resolves tenants against. Never
# called per-request in steady state — see the cache/last-known-good design
# in lib/tenant/config-cache.ts. Server-only: deliberately NOT prefixed
# NEXT_PUBLIC_, since a shared multi-tenant build must never bake any single
# tenant's secrets into the JS bundle.
CONTROL_PLANE_URL=
CONTROL_PLANE_TOKEN=

# --- Single-tenant production (jibbit.ch selbst) ------------------------------
# Tenant-Tabelle für Hosts, die NICHT über die Control Plane provisioniert
# wurden — allen voran jibbit.ch, das es vor der Plattform gab. Wird VOR der
# Control Plane konsultiert und ist keine Default-Route: ein Host, der hier
# nicht steht, läuft weiter in die Control Plane und danach in 404.
#
# Server-only, bewusst ohne NEXT_PUBLIC_-Präfix — enthält pro Tenant einen
# Publishable Key, und ein gemeinsam genutztes Image darf keine
# tenant-spezifische Konfiguration ins Browser-Bundle backen.
#
# STATIC_TENANTS='[{"id":"jibbit","host":"jibbit.ch","aliases":["www.jibbit.ch"],"backendUrl":"http://medusa:9000","publishableKey":"pk_...","theme":{"storeName":"jibbit","domain":"jibbit.ch","themeColor":"#F6F5F3"}}]'
STATIC_TENANTS=

# --- Indexierung (Staging vs. Produktion) -------------------------------------
# Darf dieses Deployment in Suchmaschinen erscheinen?
#   true  -> indexierbar (PRODUKTION). Auch 1/on/ja/yes.
#   alles andere — AUCH NICHT GESETZT ODER VERTIPPT -> NOINDEX:
#     X-Robots-Tag "noindex, nofollow", Meta-Tag, robots.txt Disallow: /,
#     leere sitemap.xml. Richtig für Staging (test.jibbit.ch).
#
# ⚠️ GO-LIVE: Die sichere Voreinstellung ist NOINDEX. Die Produktion MUSS
# SITE_INDEXABLE=true setzen, sonst verschwindet sie still aus Google. Der
# Server meldet den Zustand bei jedem Start im Log ("[seo] ...").
#
# Bewusst OHNE NEXT_PUBLIC_-Präfix: wird zur LAUFZEIT je Anfrage gelesen
# (lib/seo/indexing.ts), nicht beim Build ins Image gebacken. Ein Neustart
# genügt, ein neuer Build ist nicht nötig.
#
# DOCKER-COMPOSE: muss im Repo medusa-ecom beim Dienst "storefront" unter
# environment: stehen (SITE_INDEXABLE: ${SITE_INDEXABLE:-}) — Compose reicht
# nur weiter, was dort ausdrücklich aufgeführt ist.
SITE_INDEXABLE=

# --- Kasse ------------------------------------------------------------------
# Kontopflicht an der Kasse: verlangt /checkout eine Anmeldung?
#   true  (Voreinstellung) -> Bestellen nur mit Kundenkonto; Adresse wird aus
#                             dem Konto vorausgefüllt und dort gesichert.
#   false                  -> Gastbestellung wie früher.
# Der Schalter und seine Dokumentation: lib/checkout/account-requirement.ts.
# Wirkt ab dem nächsten Prozessstart; ein neuer Build ist nicht nötig.
CHECKOUT_REQUIRE_ACCOUNT=true

# --- Analyse (PostHog) -------------------------------------------------------
# PostHog Cloud, Region EU. Den Projektschlüssel gibt es nach dem Anlegen des
# Kontos unter https://eu.posthog.com -> Project Settings -> "Project API Key"
# (beginnt mit "phc_"). Leer lassen => es wird KEINE Analyse geladen — kein
# Fehler, kein Absturz, nur ein einmaliger Hinweis im Serverlog.
#
# Geladen wird PostHog ohnehin erst NACH erteilter Cookie-Einwilligung
# (lib/consent/* + lib/analytics/gate.ts); ein Widerruf stoppt die Erfassung
# sofort.
#
# Bewusst OHNE NEXT_PUBLIC_-Präfix: die Werte werden zur LAUFZEIT serverseitig
# gelesen (lib/analytics/server.ts) und dem Client als Prop übergeben. Ein
# NEXT_PUBLIC_-Wert würde zur BUILD-Zeit ins Image gebacken — dieselbe Falle
# wie bei STATIC_TENANTS, siehe oben.
#
# DOCKER-COMPOSE: Die Storefront bekommt ihre Umgebung im Repo medusa-ecom
# (Dienst "storefront", Block environment:). Compose reicht NUR weiter, was
# dort ausdrücklich aufgeführt ist — POSTHOG_KEY und POSTHOG_HOST müssen dort
# also eingetragen werden, sonst kommen sie im Container nie an.
#
# MANDANTEN: vorerst EIN Schlüssel für alle — die Daten aller Mandanten laufen
# damit in EINEM PostHog-Projekt zusammen (Trennung später: Schlüssel pro
# Tenant in der TenantConfig; bis dahin unterscheidet die Event-Eigenschaft
# tenant_host). Siehe lib/analytics/server.ts.
POSTHOG_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
